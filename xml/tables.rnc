datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"
start = tables
# wdg: Tables are currently formatted as they are in the html, excluding the css. Currently unsure on how to enforce table rows all having the same amount of cells.
tables = element tables {table}
table = element table {thead, tr+}
thead = element thead {tr+}
tr = element tr {td+}
td = element td {mixed{spec*}}
spec = element spec {(minmax | race | sex | class)+, text} # nrg: td has to be mixed because it has text and elements, but spec can only have attributes and contain text
minmax = attribute minmax { list { ("max" | "min")+ } } # nrg: found list which allows for this (and on class and race)
class = attribute class { list { ("assassin" | "bard" | "cleric" | "druid" | "fighter" | "illusionist" | "magic-user" | "monk" | "paladin" | "ranger" | "thief")+ } }
sex = attribute sex {list { ("male" | "female")+ } }
race = attribute race { list { ("dwarf" | "elf" | "gnome" | "half-elf" | "halfling" | "half-orc" | "human")+ } }