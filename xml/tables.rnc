datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"
start = tables
# wdg: Tables are currently formatted as they are in the html, excluding the css. Currently unsure on how to enforce table rows all having the same amount of cells.
tables = element tables {table}
table = element table {thead, tr+}
thead = element thead {tr+}
tr = element tr {td+}
td = element td {mixed{(minmax | race | sex | class)*}}
minmax = attribute minmax {"maximum" | "minimum"}
class = attribute class {"assassin" | "bard" | "cleric" | "druid" | "fighter" | "illusionist" | "magic-user" | "monk" | "paladin" | "ranger" | "thief"}
sex = attribute sex {"male" | "female"}
race = attribute race {"dwarf" | "elf" | "gnome" | "half-elf" | "halfling" | "half-orc" | "human" }